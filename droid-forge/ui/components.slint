import { Md3 } from "theme.slint";

// Material Symbols vector icon (24x24 viewbox)
export component Md3Icon inherits Rectangle {
    in property <string> path-data;
    in property <color> tint: Md3.on-surface-variant;
    in property <length> icon-size: 20px;

    width: icon-size;
    height: icon-size;
    background: transparent;

    Path {
        width: 100%;
        height: 100%;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: root.tint;
        commands: root.path-data;
    }
}

// MD3 Navigation Rail Item (56x32 pill indicator)
export component Md3NavRailItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-path;
    in property <bool> active: false;
    callback clicked();

    width: 72px;
    height: 60px;
    background: transparent;

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    VerticalLayout {
        alignment: center;
        spacing: 4px;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 32px;
                border-radius: 16px;
                background: root.active
                    ? Md3.secondary-container
                    : (ta.has-hover ? Md3.hover-tint : transparent);
                animate background { duration: 140ms; }

                Md3Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    path-data: root.icon-path;
                    icon-size: 20px;
                    tint: root.active ? Md3.on-secondary-container : Md3.on-surface-variant;
                }
            }
        }

        Text {
            text: root.label;
            font-size: 11px;
            font-weight: root.active ? 600 : 500;
            color: root.active ? Md3.on-surface : Md3.on-surface-variant;
            horizontal-alignment: center;
        }
    }
}

// MD3 Icon Button (40x40 circle)
export component Md3IconButton inherits Rectangle {
    in property <string> icon-path;
    in property <bool> enabled: true;
    in property <color> tint: Md3.on-surface-variant;
    callback clicked();

    width: 40px;
    height: 40px;
    horizontal-stretch: 0;
    border-radius: 20px;
    background: !root.enabled
        ? transparent
        : (ta.pressed ? Md3.pressed-tint : (ta.has-hover ? Md3.hover-tint : transparent));
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    Md3Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        path-data: root.icon-path;
        icon-size: 20px;
        tint: root.enabled ? root.tint : Md3.on-surface-muted;
    }
}

// MD3 Filled Button (Primary Google Blue)
export component Md3FilledButton inherits Rectangle {
    in property <string> text;
    in property <string> icon-path: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 84px;
    horizontal-stretch: 0;
    border-radius: 19px;
    background: !root.enabled
        ? Md3.surface-container-high
        : (ta.pressed ? Md3.primary-hover : (ta.has-hover ? Md3.primary-hover : Md3.primary));
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.icon-path != "" ? 14px : 18px;
        padding-right: 18px;
        spacing: 7px;
        alignment: center;

        if root.icon-path != "": VerticalLayout {
            alignment: center;
            Md3Icon {
                path-data: root.icon-path;
                icon-size: 17px;
                tint: root.enabled ? Md3.on-primary : Md3.on-surface-muted;
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 600;
            color: root.enabled ? Md3.on-primary : Md3.on-surface-muted;
            vertical-alignment: center;
        }
    }
}

