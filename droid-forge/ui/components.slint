// MD3 Outlined Button
export component Md3OutlinedButton inherits Rectangle {
    in property <string> text;
    in property <string> icon-path: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 38px;
    min-width: 76px;
    horizontal-stretch: 0;
    border-radius: 19px;
    border-width: 1px;
    border-color: root.enabled ? Md3.outline-variant : Md3.surface-container-high;
    background: !root.enabled
        ? transparent
        : (ta.pressed ? Md3.pressed-tint : (ta.has-hover ? Md3.hover-tint : transparent));
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.icon-path != "" ? 13px : 16px;
        padding-right: 16px;
        spacing: 7px;
        alignment: center;

        if root.icon-path != "": VerticalLayout {
            alignment: center;
            Md3Icon {
                path-data: root.icon-path;
                icon-size: 17px;
                tint: root.enabled ? Md3.primary : Md3.on-surface-muted;
            }
        }

        Text {
            text: root.text;
            font-size: 13px;
            font-weight: 500;
            color: root.enabled ? Md3.on-surface : Md3.on-surface-muted;
            vertical-alignment: center;
        }
    }
}

