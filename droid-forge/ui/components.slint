// MD3 Filter / Assist Chip
export component Md3Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: root.selected ? 0px : 1px;
    border-color: Md3.outline-variant;
    background: root.selected
        ? Md3.secondary-container
        : (ta.has-hover && root.enabled ? Md3.hover-tint : Md3.surface-container);
    animate background { duration: 120ms; }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        alignment: center;
        Text {
            text: root.text;
            font-size: 12px;
            font-weight: root.selected ? 600 : 500;
            color: !root.enabled
                ? Md3.on-surface-muted
                : (root.selected ? Md3.on-secondary-container : Md3.on-surface-variant);
            vertical-alignment: center;
        }
    }
}

// MD3 Compact Switch Toggle
export component Md3ToggleChip inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;

    height: 30px;
    horizontal-stretch: 0;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.checked ? Md3.primary : Md3.outline-variant;
    background: root.checked ? Md3.primary-container : transparent;
    animate background { duration: 120ms; }

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 11px;
        spacing: 6px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 4px;
                border-width: 1.5px;
                border-color: root.checked ? Md3.primary : Md3.outline;
                background: root.checked ? Md3.primary : transparent;

                if root.checked: Md3Icon {
                    x: 1px;
                    y: 1px;
                    icon-size: 12px;
                    tint: Md3.on-primary;
                    path-data: "M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z";
                }
            }
        }

        Text {
            text: root.text;
            font-size: 12px;
            font-weight: 500;
            color: root.checked ? Md3.on-primary-container : Md3.on-surface-variant;
            vertical-alignment: center;
        }
    }
}

// MD3 Outlined Input Field
export component Md3TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    callback accepted();

    height: 38px;
    horizontal-stretch: 1;
    border-radius: 10px;
    border-width: input.has-focus ? 1.5px : 1px;
    border-color: input.has-focus ? Md3.primary : Md3.outline-variant;
    background: Md3.surface-container-low;
    clip: true;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        Rectangle {
            horizontal-stretch: 1;
            background: transparent;

            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                color: Md3.on-surface-muted;
                font-size: 13px;
                vertical-alignment: center;
                overflow: elide;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: Md3.on-surface;
                font-size: 13px;
                single-line: true;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
        }
    }
}

// MD3 Surface Card Container
export component Md3Card inherits Rectangle {
    in property <string> title;
    in property <string> subtitle: "";

    border-radius: 16px;
    background: Md3.surface-container;
    border-width: 1px;
    border-color: Md3.outline-variant;

    VerticalLayout {
        padding: 18px;
        spacing: 12px;

        if root.title != "": VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 14px;
                font-weight: 600;
                color: Md3.on-surface;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: 12px;
                color: Md3.on-surface-variant;
            }
        }

        @children
    }
}

// Key-value spec row for the Device Inspector sidebar
export component SpecRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Md3.on-surface;

    spacing: 8px;
    alignment: space-between;

    Text {
        text: root.label;
        font-size: 12px;
        color: Md3.on-surface-variant;
        horizontal-stretch: 0;
    }

    Text {
        text: root.value != "" ? root.value : "—";
        font-size: 12px;
        font-weight: 500;
        color: root.value != "" ? root.value-color : Md3.on-surface-muted;
        horizontal-alignment: right;
        overflow: elide;
        horizontal-stretch: 1;
    }
}
